{
  "name": "kikoeru-express",
  "version": "0.6.2",
  "description": "A self-hosted media server for listening to your DLsite voice works.",
  "homepage": "https://github.com/kikoeru-project/kikoeru-express",
  "repository": {
    "type": "git",
    "url": "git@github.com:kikoeru-project/kikoeru-express.git"
  },
  "keywords": [
    "kikoeru"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kikoeru-express": "app.js"
  },
  "pkg": {
    "scripts": [
      "filesystem/scanner.js",
      "filesystem/updater.js",
      "dist/**/*.js",
      "database/migrations/*",
      "database/knexfile.js",
      "database/storage.js"
    ],
    "assets": [
      "dist/**/*",
      "static/**/*",
      "node_modules/sqlite3/build/Release/node_sqlite3.node"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "config/*",
      "sqlite/*"
    ],
    "delay": "2500"
  },
  "scripts": {
    "start": "node --trace-warnings app.js",
    "dev": "nodemon --trace-warnings app.js",
    "scan": "node --trace-warnings ./filesystem/scanner.js",
    "build": "pkg -t node24-win-x64,node24-linux-arm64 package.json --out-path package",
    "test": "cross-env eslint . && cross-env NODE_ENV=test mocha test/",
    "lint": "eslint . --fix"
  },
  "author": "Watanuki-Kimihiro",
  "contributors": [
    "umonaca <mw2010a@gmail.com>"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@umonaca/umzug": "^2.3.1",
    "axios": "^1.15.2",
    "bluebird": "^3.7.2",
    "body-parser": "^2.2.2",
    "cheerio": "^1.0.0-rc.6",
    "compare-versions": "^6.1.1",
    "compression": "^1.7.4",
    "connect-history-api-fallback": "^2.0.0",
    "dotenv": "^17.4.2",
    "express": "^4.17.1",
    "express-jwt": "^6.0.0",
    "express-validator": "^7.3.2",
    "htmlparser2": "^4.1.0",
    "invariant": "^2.2.4",
    "jschardet": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1",
    "knex-migrate": "^1.7.4",
    "limit-promise": "^1.0.6",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "natural-orderby": "^2.0.3",
    "recursive-readdir": "^2.2.2",
    "socket.io": "^2.4.1",
    "socketio-jwt-auth": "^0.2.1",
    "sqlite3": "^6.0.1",
    "string-random": "^0.1.3",
    "tunnel-agent": "^0.6.0",
    "url-join": "^4.0.1",
    "uuid": "^8.3.2",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "chai": "^4.3.4",
    "chai-string": "^1.5.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "mocha": "^8.3.2",
    "nodemon": "^3.0.3",
    "pkg": "^5.8.1",
    "prettier": "3.2.5",
    "serve-index": "^1.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
